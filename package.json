{
	"name": "icdc-core",
	"version": "0.0.10",
	"scripts": {
		"build": "./scripts/build.sh",
		"test:unit": "scripts/test.unit.sh",
		"test:integration": "scripts/test.integration.sh",
		"test": "npm run test:unit",
		"format": "prettier --write . && ./scripts/format.sh",
		"format:rust": "./scripts/format.rust.sh",
		"lint": "prettier --check . && ./scripts/lint.sh",
		"lint:rust": "./scripts/lint.rust.sh --fix",
		"quality": "npm run format && npm run lint",
		"quality:rust": "npm run format:rust && npm run lint:rust",
		"did": "./scripts/did.sh && npm run format && npm run lint",
		"deploy": "dfx deploy --network local --upgrade-unchanged",
		"deploy:staging": "dfx deploy --network staging --upgrade-unchanged",
		"deploy:prod": "dfx deploy --network ic --upgrade-unchanged",
		"reinstall": "./scripts/reinstall.sh",
		"reinstall:staging": "./scripts/reinstall.sh --staging",
		"reinstall:prod": "./scripts/reinstall.sh --ic",
		"init:registry": "./scripts/init.registry.sh",
		"init:registry:staging": "./scripts/init.registry.sh --staging",
		"init:registry:prod": "./scripts/init.registry.sh --ic",
		"init:clearing": "./scripts/init.clearing.sh",
		"init:clearing:staging": "./scripts/init.clearing.sh --staging",
		"init:clearing:prod": "./scripts/init.clearing.sh --ic",
		"init": "npm run init:registry && npm run init:clearing",
		"init:staging": "npm run init:registry:staging && npm run init:clearing:staging",
		"init:prod": "npm run init:registry:prod && npm run init:clearing:prod"
	},
	"devDependencies": {
		"@icp-sdk/bindgen": "^0.4.0",
		"prettier": "^3.8.3",
		"prettier-plugin-motoko": "^0.13.0",
		"prettier-plugin-organize-imports": "^4.3.0"
	}
}
