type AddSeriesParams = record {
	strike : opt nat64;
	payoff_type : PayoffType;
	settlement_asset : text;
	underlying : text;
	expiry : nat64;
	oracle_source : text
};
type AddSeriesResult = variant { Ok : text; Err : RegistryError };
type PayoffType = variant { Put; Binary; Call };
type RegistryError = variant { SeriesAlreadyExists };
type Series = record {
	strike : opt nat64;
	payoff_type : PayoffType;
	series_id : text;
	settlement_asset : text;
	underlying : text;
	expiry : nat64;
	oracle_source : text
};
service : {
	add_series : (AddSeriesParams) -> (AddSeriesResult);
	get_series : (text) -> (opt Series) query;
	list_series : () -> (vec Series) query
}
