type AcceptPositionTransferResult = variant { Ok : bool; Err : ClearingError };
type Asset = variant { Icrc : principal };
type ClearingError = variant {
	PayoffMathOverflow;
	FetchingBalanceFailed : text;
	BuyerInsufficientMargin;
	InsufficientExcessMargin : record {
		requested : nat;
		required : nat;
		current : nat
	};
	NoMarginAccountFound;
	BalanceMathOverflow;
	GettingRegistrySeriesFailed : text;
	WithdrawCollateralMathOverflow;
	UnsupportedSettlementAsset;
	SellerInsufficientMargin;
	Unauthorized;
	FeeMathOverflow;
	RegistryNotSet;
	SeriesNotFound;
	TransferFailed : text;
	UnsupportedLedger;
	FetchingFeeFailed : text
};
type DepositCollateralParams = record {
	deposit_id : text;
	asset : Asset;
	amount : nat
};
type DepositCollateralResult = variant { Ok; Err : ClearingError };
type FreezePositionForTransferParams = record {
	series_id : text;
	user : principal
};
type GetMarginAccountResult = variant {
	Ok : MarginAccount;
	Err : ClearingError
};
type GetPositionParams = record { series_id : text; user : principal };
type MarginAccount = record {
	required_margin : nat;
	user : principal;
	balances : vec record { Asset; nat }
};
type PayoffType = variant { Put; Binary; Call };
type Position = record { series_id : text; net_qty : int; user : principal };
type PositionProof = record {
	qty : int;
	signature : blob;
	series_id : text;
	user : principal;
	clearing_id : principal
};
type Series = record {
	strike : opt nat64;
	payoff_type : PayoffType;
	series_id : text;
	settlement_asset : SettlementAsset;
	underlying : text;
	expiry : nat64;
	oracle_source : text
};
type SettleSeriesParams = record { series_id : text; settlement_price : nat64 };
type SettleSeriesResult = variant { Ok; Err : ClearingError };
type SettlementAsset = variant { Icp; CkUsdc };
type SubmitMatchedTradeParams = record {
	qty : int;
	series_id : text;
	seller : principal;
	buyer : principal;
	price : nat64
};
type SubmitMatchedTradeResult = variant { Ok : bool; Err : ClearingError };
type WithdrawCollateralParams = record {
	asset : Asset;
	withdrawal_id : text;
	amount : nat
};
service : {
	accept_position_transfer : (PositionProof) -> (AcceptPositionTransferResult);
	deposit_collateral : (DepositCollateralParams) -> (DepositCollateralResult);
	freeze_position_for_transfer : (FreezePositionForTransferParams) -> (
		opt PositionProof
	);
	get_margin_account : (principal) -> (GetMarginAccountResult);
	get_margin_account_fresh : (principal) -> (GetMarginAccountResult);
	get_position : (GetPositionParams) -> (opt Position) query;
	get_positions : (principal) -> (vec record { text; Position }) query;
	list_series : () -> (vec Series) query;
	set_registry_canister : (principal) -> ();
	settle_series : (SettleSeriesParams) -> (SettleSeriesResult);
	submit_matched_trade : (SubmitMatchedTradeParams) -> (
		SubmitMatchedTradeResult
	);
	withdraw_collateral : (WithdrawCollateralParams) -> (SettleSeriesResult)
}
