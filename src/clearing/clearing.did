type AcceptPositionTransferResult = variant { Ok : bool; Err : TradeError };
type AdminError = variant {
	TransferFailed : text;
	InsufficientFunds;
	Common : CommonError
};
type AdminResult = variant { Ok : nat; Err : AdminError };
type Asset = variant {
	Erc20 : ErcToken;
	Icrc : principal;
	NativeEvm : NativeEvmAsset
};
type AssetId = text;
type AssetError = variant {
	TransferError : text;
	InsufficientBalance : record { balance : nat; required : nat };
	MathOverflow;
	CallError : record { method : text; code : int32; message : text };
	InvalidAssetForHandler;
	UnsupportedAsset
};
type CancelLimitOrderParams = record { order_id : text };
type Chain = variant { Bsc; Base; Ethereum; Polygon };
type ClearingConfig = record {
	insurance_fund_fee_ratio : nat16;
	signer_canister : principal;
	evm_rpc : principal
};
type CommonError = variant {
	Internal : text;
	MathOverflow;
	Unauthorized;
	RegistryNotSet
};
type DecimalValue = record { decimals : nat8; value : nat };
type DepositCollateralError = variant { MathOverflow; Asset : AssetError };
type DepositCollateralParams = record {
	deposit_id : text;
	asset_id : AssetId;
	amount : nat
};
type DepositCollateralResult = variant { Ok; Err : DepositCollateralError };
type Description = record {
	html : opt text;
	markdown : opt text;
	plain : text
};
type ErcToken = record {
	decimals : nat8;
	token_address : text;
	chain_id : nat64
};
type Event = record {
	qty : int;
	series_id : text;
	user : principal;
	timestamp : nat64;
	event_id : nat64;
	price : Price;
	event_type : EventType;
	clearing_id : principal
};
type EventType = variant { OrderPlaced; Executed; Liquidated; Settled };
type FiatUnit = variant { Usd; Eur; Gbp; Chf };
type CanonicalCryptoUnit = variant { Btc; Eth; Icp };
type NonMonetaryUnit = variant { Points };
type PayoutUnit = variant {
	Fiat : FiatUnit;
	Crypto : CanonicalCryptoUnit;
	NonMonetary : NonMonetaryUnit
};
type FundType = variant { Insurance; Treasury };
type GetFundsResult = record {
	insurance_fund : vec record { AssetId; nat };
	treasury : vec record { AssetId; nat }
};
type GetAccountStateParams = record { refresh : opt bool };
type GetAccountStateResult = variant {
	Ok : AccountState;
	Err : AccountStateError
};
type GetPositionParams = record { series_id : text };
type HttpRequest = record {
	url : text;
	method : text;
	body : blob;
	headers : vec record { text; text }
};
type HttpResponse = record {
	body : blob;
	headers : vec record { text; text };
	status_code : nat16
};
type LimitOrder = record {
	qty : int;
	creator : principal;
	block_index : nat;
	series_id : text;
	side : Side;
	order_id : text;
	price : Price
};
type ListOrdersParams = record { series_id : opt text };
type AccountState = record {
	reserved_margin_usd : nat;
	collateral_balances : vec record { AssetId; nat };
	user : principal;
	cash_balance_usd : int
};
type AccountStateError = variant {
	NoAccountStateFound;
	MathOverflow;
	Asset : AssetError
};
type NativeEvmAsset = record { decimals : nat8; chain_id : nat64 };
type PayoffType = variant { Put; Binary; Call };
type Position = record {
	series_id : text;
	net_qty : int;
	user : principal;
	reserved_margin_usd : nat
};
type Price = record {
	timestamp : opt nat64;
	oracle_id : opt text;
	decimal : DecimalValue
};
type Series = record {
	title : text;
	strike : opt Price;
	creator : principal;
	payoff_type : PayoffType;
	expiry_ns : nat64;
	series_id : text;
	payout_unit : PayoutUnit;
	underlying : text;
	description : Description;
	created_at_ns : nat64;
	price_precision : nat8;
	oracle_source : text
};
type SettleSeriesParams = record { series_id : text; settlement_price : Price };
type SettleSeriesResult = variant { Ok; Err : SettlementError };
type SettlementError = variant {
	MathOverflow;
	InconsistentSettlementPrice : record { Price; Price };
	Asset : AssetError;
	Common : CommonError
};
type Side = variant { Buy; Sell };
type Stats = record {
	total_users : nat64;
	asset_balances : vec record { AssetId; nat };
	total_collateral_locked_usd : nat;
	total_trades : nat64;
	total_series : nat64;
	open_interest : nat;
	event_counts : vec record { text; nat64 }
};
type SubmitLimitOrderParams = record {
	qty : int;
	series_id : text;
	side : Side;
	order_id : text;
	price : Price
};
type SubmitMarketOrderParams = record {
	trade_id : text;
	matching_order_id : text
};
type SubmitMatchedTradeParams = record {
	qty : int;
	trade_id : text;
	series_id : text;
	seller : principal;
	buyer : principal;
	price : Price
};
type SubmitMatchedTradeResult = variant { Ok : bool; Err : TradeError };
type TradeError = variant {
	OrderNotFound : text;
	RegistryError : text;
	InsufficientMargin : record {
		balance : nat;
		user : principal;
		required : nat
	};
	NotOrderCreator;
	SeriesNotFound : text;
	Common : CommonError
};
type WithdrawCollateralError = variant {
	InsufficientExcessMargin : record { requested : nat; available : nat };
	MathOverflow;
	Asset : AssetError
};
type WithdrawCollateralParams = record {
	asset_id : AssetId;
	withdrawal_id : text;
	amount : nat
};
type WithdrawCollateralResult = variant { Ok; Err : WithdrawCollateralError };
type WithdrawFundParams = record {
	to : principal;
	fund_type : FundType;
	asset_id : AssetId;
	amount : nat
};
type UpdateCollateralAssetParams = record { config : CollateralAssetConfig };
type CollateralAssetConfig = record {
	asset_id : AssetId;
	asset : Asset;
	symbol : text;
	decimals : nat8;
	price_usd : DecimalValue;
	haircut_bps : nat16;
	is_enabled : bool
};
service : {
	accept_position_transfer : (
		record {
			user : principal;
			qty : int;
			series_id : text;
			transfer_id : text
		}
	) -> (AcceptPositionTransferResult);
	cancel_limit_order : (CancelLimitOrderParams) -> (SubmitMatchedTradeResult);
	deposit_collateral : (DepositCollateralParams) -> (DepositCollateralResult);
	update_collateral_asset : (UpdateCollateralAssetParams) -> ();
	get_funds : () -> (GetFundsResult) query;
	get_account_state : (GetAccountStateParams) -> (GetAccountStateResult);
	get_account_state_query : () -> (GetAccountStateResult) query;
	get_orders : () -> (vec LimitOrder) query;
	get_position : (GetPositionParams) -> (opt Position) query;
	get_positions : () -> (vec record { text; Position }) query;
	get_trade_history : () -> (vec Event) query;
	http_request : (HttpRequest) -> (HttpResponse) query;
	list_orders : (ListOrdersParams) -> (vec LimitOrder) query;
	list_series : () -> (vec Series) query;
	metrics : () -> (text) query;
	set_registry_canister : (principal) -> ();
	settle_series : (SettleSeriesParams) -> (SettleSeriesResult);
	stats : () -> (Stats) query;
	submit_limit_order : (SubmitLimitOrderParams) -> (SubmitMatchedTradeResult);
	submit_market_order : (SubmitMarketOrderParams) -> (SubmitMatchedTradeResult);
	submit_matched_trade : (SubmitMatchedTradeParams) -> (
		SubmitMatchedTradeResult
	);
	update_config : (ClearingConfig) -> ();
	withdraw_collateral : (WithdrawCollateralParams) -> (
		WithdrawCollateralResult
	);
	withdraw_fund : (WithdrawFundParams) -> (AdminResult)
}
