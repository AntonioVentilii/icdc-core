// Outcome of a position transfer acceptance.
type AcceptPositionTransferResult = variant {
	// Returns `true` if the transfer was successfully accepted and processed.
	Ok : bool;
	// Failed to accept the position transfer.
	Err : TradeError
};
// Represents a user's account state in the clearing system.
type AccountState = record {
	// The owner of the account.
	user : principal;
	// The total required margin reserved for current activity, scoped by domain.
	reserved_margins_usd : vec record { BalanceDomain; nat };
	// Internal realised `PnL` / debt / credits, scoped by domain.
	cash_balances_usd : vec record { BalanceDomain; int };
	// Real deposited collateral assets and their balances, scoped by domain.
	balances : vec record { BalanceDomain; vec record { text; nat } }
};
// Errors related to account state retrieval or state.
type AccountStateError = variant {
	// Overflow during account state calculation.
	MathOverflow;
	// An error occurred while interacting with the asset.
	Asset : AssetError;
	// No account state exists for the specified user.
	NoAccountStateFound
};
// Enhanced response for account state with calculated USD values.
type AccountStateResponse = record {
	// Detailed worth of each collateral asset.
	assets : vec AssetWorth;
	// The raw account state.
	state : AccountState;
	// Total equity in USD (cash balance + sum of collateral values).
	total_equity_usd : nat;
	// Available equity in USD (total equity - reserved margin).
	available_margin_usd : int
};
// Represents a supported asset in the ICDC ecosystem.
type Asset = variant {
	// An ERC-20 token on an EVM-compatible chain.
	Erc20 : ErcToken;
	// An ICRC-compliant token identified by its canister [`Principal`].
	Icrc : principal;
	// A native asset on an EVM-compatible chain.
	NativeEvm : NativeEvmAsset
};
// Errors related to Asset interactions.
type AssetError = variant {
	// Failed to transfer tokens/assets.
	TransferError : text;
	// The account has insufficient funds for the operation.
	InsufficientBalance : record {
		// The current balance of the account.
		balance : nat;
		// The amount required for the operation.
		required : nat
	};
	// Overflow during internal balance calculations.
	MathOverflow;
	// The asset identifier is invalid or incorrectly formatted.
	InvalidAssetId : text;
	// A cross-canister or RPC call failed.
	CallError : record {
		// The name of the method that failed.
		method : text;
		// The rejection code from the IC or error code from RPC.
		code : int32;
		// The rejection/error message.
		message : text
	};
	// The asset variant is incompatible with the current handler.
	InvalidAssetForHandler;
	// The specified asset is not supported.
	UnsupportedAsset
};
// Dynamic metrics and risk parameters for a collateral asset.
type AssetMetrics = record {
	// Haircut in basis points (e.g., 1000 = 10% haircut, 90% value).
	haircut_bps : nat16;
	// Latest known transfer fee for the asset.
	latest_transfer_fee : opt nat;
	// Optional asset-specific insurance fund fee ratio in basis points.
	insurance_fee_ratio : opt nat16;
	// Last time the asset metrics were updated (in nanoseconds).
	last_updated_ns : opt nat64;
	// Optional asset-specific protocol fee ratio in basis points.
	protocol_fee_ratio : opt nat16;
	// Oracle-updated price in USD (canonical accounting unit).
	price_usd : DecimalValue
};
// Represents the worth of a specific asset in the user's account.
type AssetWorth = record {
	// The USD value of the balance (before haircut).
	pre_haircut_value_usd : nat;
	// The applied haircut in basis points.
	haircut_bps : nat16;
	// The raw balance of the asset.
	balance : nat;
	// The USD value of the balance (including haircut).
	value_usd : nat;
	// The unique identifier of the asset.
	asset_id : text
};
// Represents a distinct domain for balances and trading logic.
type BalanceDomain = variant {
	// VICI XP (loyalty points) — segregated from Playground test assets.
	ViciXp;
	// Non-monetary social bets (e.g., betting a pizza).
	Social;
	// Testnet / sandbox collateral (e.g. TESTICP, Sepolia) — not real funds.
	Playground;
	// Real collateralized trading (e.g., using ckUSDC, ICP).
	Settlement
};
type CancelFundWithdrawalError = variant {
	PlanNotFound;
	InvalidPlanStatus;
	Common : CommonError
};
type CancelFundWithdrawalParams = record { request_id : text };
type CancelFundWithdrawalResult = variant {
	Ok;
	Err : CancelFundWithdrawalError
};
// Input parameters for cancelling a limit order.
type CancelLimitOrderParams = record {
	// Unique identifier for the order to cancel.
	order_id : text
};
// Configuration for a supported collateral asset.
type CollateralAssetConfig = record {
	// The number of decimal places defined by the underlying ledger.
	decimals : nat8;
	// The underlying configuration required to interact with the asset's ledger.
	asset : Asset;
	// Whether the asset is currently enabled for deposits.
	is_enabled : bool;
	// Balance domains where this asset may be deposited or withdrawn.
	allowed_balance_domains : vec BalanceDomain;
	// Identifier of the oracle responsible for updating this asset's metrics.
	oracle_id : opt text;
	// The canonical identifier for this asset within the clearing protocol.
	asset_id : text;
	// The ticker symbol used for display purposes.
	symbol : text
};
// Combined structure for public consumption of asset information.
type CollateralAssetInfo = record {
	metrics : opt AssetMetrics;
	config : CollateralAssetConfig
};
// Generic errors that can occur across multiple modules.
type CommonError = variant {
	// An unexpected internal error occurred.
	Internal : text;
	// The input provided for the request is invalid.
	InvalidInput : text;
	// A mathematical calculation resulted in an overflow or underflow.
	MathOverflow;
	// The caller does not have permission to perform this action.
	Unauthorized;
	// The registry canister principal has not been configured.
	RegistryNotSet
};
// Global configuration for the Clearing canister.
type Config = record {
	// The global insurance fund fee ratio in basis points (1 bp = 0.01%).
	insurance_fund_fee_ratio : nat16;
	// The comprehensive configuration for the internal accounting ledger (vUSD).
	internal_ledger : CollateralAssetConfig;
	// The principal of the Chain Fusion Signer canister.
	signer_canister : principal;
	// The economic epoch version.
	version : nat32;
	// The principal of the EVM RPC canister.
	evm_rpc : principal;
	// The global protocol fee ratio (Treasury) in basis points.
	protocol_fee_ratio : nat16
};
// A generic representation of a decimal value with fixed precision.
// This decouples numeric logic from domain-specific types like Price or Quantity.
type DecimalValue = record {
	// The number of decimal places (exponent).
	decimals : nat8;
	// The numeric value (mantissa).
	value : nat
};
// Errors occurring during collateral deposit.
type DepositCollateralError = variant {
	// The asset is not permitted in this balance domain.
	DomainNotAllowed : record { domain : BalanceDomain; asset_id : text };
	// Overflow during collateral calculation.
	MathOverflow;
	// An error occurred while interacting with the asset.
	Asset : AssetError
};
// Input parameters for depositing collateral.
type DepositCollateralParams = record {
	// Unique identifier for the deposit operation.
	deposit_id : text;
	// The specific balance domain to deposit into (defaults to Settlement).
	domain : opt BalanceDomain;
	// The unique identifier of the asset to deposit.
	asset_id : text;
	// The amount of the asset to deposit.
	amount : nat
};
// Outcome of a collateral deposit operation.
type DepositCollateralResult = variant {
	// Deposit was successfully planned or executed.
	Ok;
	// Failed to process deposit.
	Err : DepositCollateralError
};
// A multiformat description.
// Provides multiple versions of the same content for different rendering environments.
type Description = record {
	// Optional HTML version of the description.
	html : opt text;
	// Optional markdown version of the description.
	markdown : opt text;
	// The mandatory plain text description.
	plain : text
};
// Configurable policy for a balance domain.
//
// Controls domain-specific behavior such as fee ratios and feature flags.
// Domains default to identical policies so risk enforcement is uniform unless overridden.
type DomainPolicy = record {
	// Whether deposits of real collateral assets are accepted in this domain.
	deposits_enabled : bool;
	// Optional override for the protocol fee ratio (bps).
	// When `None`, the global `Config` value is used.
	protocol_fee_ratio_override : opt nat16;
	// Human-readable label for this domain.
	label : text;
	// Whether withdrawals of real collateral assets are allowed from this domain.
	withdrawals_enabled : bool;
	// Optional override for the insurance fund fee ratio (bps).
	// When `None`, the global `Config` value is used.
	insurance_fund_fee_ratio_override : opt nat16
};
// Represents an ERC-20 token on a specific EVM chain.
type ErcToken = record {
	// The number of decimals the token uses (e.g., 18 for ETH, 6 for USDC).
	decimals : nat8;
	// The contract address of the token.
	token_address : text;
	// The ID of the EVM chain where the token is deployed.
	chain_id : nat64
};
// A recorded event in the clearing system.
type Event = record {
	// The quantity involved in the event.
	qty : int;
	// The series ID associated with the event.
	series_id : text;
	// The user associated with the event.
	user : principal;
	// Timestamp in nanoseconds since UNIX epoch.
	timestamp : nat64;
	// Unique identifier for the event.
	event_id : nat64;
	// The price at which the event occurred (if applicable).
	price : Price;
	// The type of the event.
	event_type : EventType;
	// The principal of the clearing canister.
	clearing_id : principal
};
// Categories of significant events in the clearing system.
type EventType = variant {
	// A new order was recorded.
	OrderPlaced;
	// A trade was matched and executed.
	Executed;
	// A position was liquidated due to insufficient margin.
	Liquidated;
	// A series was settled.
	Settled
};
type FiatUnit = variant { Chf; Eur; Gbp; Usd };
// Input parameters for freezing a position to prepare for a cross-canister transfer.
type FreezePositionForTransferParams = record {
	// The specific outcome for categorical markets.
	outcome_id : opt text;
	// The derivative series identifier.
	series_id : text;
	// The user whose position is being frozen.
	user : principal;
	// Unique identifier for the transfer operation.
	transfer_id : text;
	// Optional valuation price to include in the proof.
	valuation_price : opt Price
};
type FundType = variant { Insurance; Treasury };
// Input parameters for retrieving an account state.
type GetAccountStateParams = record {
	// The specific balance domain to query (defaults to Settlement if not provided).
	domain : opt BalanceDomain;
	// Whether to force a recalculation of the margin status (e.g. refresh from ledgers).
	refresh : opt bool
};
// Outcome of an account state retrieval request.
type GetAccountStateResult = variant {
	// Successfully retrieved the account state details.
	Ok : AccountStateResponse;
	// Failed to retrieve the account state.
	Err : AccountStateError
};
type GetFundsResult = record {
	insurance_fund : vec record { text; nat };
	treasury : vec record { text; nat }
};
// Input parameters for retrieving a user's position in a series.
type GetPositionParams = record {
	// Optional outcome identifier for categorical markets.
	outcome_id : opt text;
	// The derivative series identifier.
	series_id : text
};
// Represents an incoming HTTP request to the canister.
type HttpRequest = record {
	// The URL of the request.
	url : text;
	// The HTTP method (e.g., "GET", "POST").
	method : text;
	// The request body.
	body : blob;
	// The request headers.
	headers : vec record { text; text }
};
// Represents an HTTP response from the canister.
type HttpResponse = record {
	// The response body.
	body : blob;
	// The response headers.
	headers : vec record { text; text };
	// The HTTP status code.
	status_code : nat16
};
// Represents a limit order stored in the clearing canister.
type LimitOrder = record {
	// Number of Series Units (contracts), where 1 unit represents exposure to 1.0 of the
	// underlying asset. This value must always be positive; the direction (buy/long vs
	// sell/short) is determined by the `side` field.
	qty : int;
	creator : principal;
	outcome_id : opt text;
	// Amount blocked in collateral (denominated in USD base units, see `USD_DECIMALS`).
	blocked_margin_usd : nat;
	series_id : text;
	side : Side;
	order_id : text;
	// Limit price in the precision defined by the associated series (`series.price_precision`).
	price : Price;
	// The balance domain this order belongs to.
	balance_domain : BalanceDomain
};
// Input parameters for listing active limit orders.
type ListOrdersParams = record {
	// Optional series identifier to filter orders.
	series_id : opt text
};
type MigrateDomainParams = record {
	from_domain : BalanceDomain;
	migration_id : text;
	to_domain : BalanceDomain
};
type MigrateDomainResult = variant { Ok; Err : MigrationError };
type MigrationError = variant {
	NoStateTOMigrate;
	SameDomain;
	InFlightPlansExist;
	Common : CommonError
};
// Represents a native asset on an EVM-compatible chain
// (for example ETH on Ethereum/Base, POL on Polygon, or BNB on BSC).
type NativeEvmAsset = record {
	// The number of decimals the native asset uses.
	decimals : nat8;
	// The EVM chain where this native asset is used.
	chain_id : nat64
};
type NonMonetaryUnit = variant { Points; Social : SocialReward };
// Metadata for a specific outcome in a categorical market.
type Outcome = record {
	// The unique identifier of the outcome.
	id : text;
	// A short title for the outcome (e.g., "Yes", "No", "Team A").
	title : text;
	// An optional detailed description of the outcome.
	description : opt Description;
	// An optional icon URL for the outcome.
	icon_url : opt text
};
// Mechanism for ensuring idempotency in ledger payments.
type PaymentIdempotency = variant {
	// Uses the ICRC `created_at_time` field to prevent duplicate transfers.
	IcrcCreatedAtTimeNs : nat64
};
// Defines the payoff structure for a derivative contract.
type PayoffType = variant {
	// Payoff based on the positive difference between strike and underlying price.
	Put;
	// A fixed payoff if the condition is met (all-or-nothing).
	Binary;
	// Payoff based on the positive difference between underlying price and strike.
	Call;
	// A categorical market with multiple mutually exclusive outcomes.
	Categorical
};
type PayoutUnit = variant {
	Fiat : FiatUnit;
	Asset : Asset;
	NonMonetary : NonMonetaryUnit
};
// The execution status of a background operation plan.
type PlanStatus = variant {
	// The plan has been successfully completed.
	Finalised;
	// The plan is created but execution has not started.
	Planned;
	// The plan is currently being executed.
	Executing
};
// Represents an open position in a derivative series for a specific user.
type Position = record {
	// The specific outcome for categorical markets.
	outcome_id : opt text;
	// The unique identifier of the derivative series.
	series_id : text;
	// The net quantity of the position (positive for Long, negative for Short).
	net_qty : int;
	// The user who owns the position.
	user : principal;
	// The amount of margin reserved for this specific position in USD.
	reserved_margin_usd : nat
};
// A cryptographically signed proof of an open position, used for cross-canister transfers.
type PositionProof = record {
	// The quantity of the position.
	qty : int;
	// The cryptographic signature of the proof data.
	signature : blob;
	// The specific outcome for categorical markets.
	outcome_id : opt text;
	// The unique identifier of the derivative series.
	series_id : text;
	// The user whose position is being proven.
	user : principal;
	// Unique identifier for the transfer operation.
	transfer_id : text;
	// Optional valuation price for the position.
	valuation_price : opt Price;
	// The principal of the clearing canister that issued the proof.
	clearing_id : principal
};
// Encapsulates a price with its numerical value and domain-specific metadata.
// Decouples the mathematical representation (`DecimalValue`) from the
// reporting context (timestamp, oracle Source).
type Price = record {
	// Optional timestamp when this price was generated/observed.
	timestamp : opt nat64;
	// Optional identifier for the oracle source.
	oracle_id : opt text;
	// The numeric component of the price.
	decimal : DecimalValue
};
type RefreshIcrcAssetMetadataError = variant {
	AssetNotFound;
	NotAnIcrcAsset;
	Common : CommonError
};
type RefreshIcrcAssetMetadataParams = record { asset_id : text };
type RefreshIcrcAssetMetadataResult = variant {
	Ok;
	Err : RefreshIcrcAssetMetadataError
};
type RegisterIcrcAssetError = variant {
	// `allowed_balance_domains` was empty or could not be normalized.
	InvalidAllowedBalanceDomains;
	AssetAlreadyExists;
	VusdCannotBeCollateral;
	Common : CommonError
};
type RegisterIcrcAssetParams = record {
	haircut_bps : nat16;
	is_enabled : bool;
	// Non-empty. Duplicates are removed. Order is normalized for stable storage.
	allowed_balance_domains : vec BalanceDomain;
	ledger_id : principal;
	oracle_id : opt text;
	asset_id : text
};
type RegisterIcrcAssetResult = variant { Ok; Err : RegisterIcrcAssetError };
// Defines a specific derivative series (contract).
type Series = record {
	// A short, descriptive title for the series.
	title : text;
	// Target price for options, if applicable.
	strike : opt Price;
	// The principal identifier of the series creator.
	creator : principal;
	// The mathematical payoff model used for this series.
	payoff_type : PayoffType;
	// The Engine that created this series, if any.
	// `None` for series created directly by a canister controller.
	engine_id : opt text;
	// The unit in which the contract payoff is expressed.
	payout_unit : PayoutUnit;
	// Expiry timestamp in nanoseconds since UNIX epoch.
	expiry_ns : nat64;
	// An optional banner URL for the market.
	banner_url : opt text;
	// Unique identifier computed from series parameters.
	series_id : text;
	// The underlying asset ticker or identifier (e.g., "ICP/USD").
	underlying : text;
	// A detailed description of the series.
	description : Description;
	// The defined outcomes for categorical markets (ordered).
	outcomes : opt vec Outcome;
	// Timestamp of series creation in nanoseconds since UNIX epoch.
	created_at_ns : nat64;
	// An optional icon URL for the market.
	icon_url : opt text;
	// The set of trading access policies governing who may trade this series.
	// **Must never be empty** — every series carries at least one policy.
	//
	// Evaluated as a logical OR: a caller is authorized if **any** policy
	// in the list grants them access.
	//
	// - `[Open]` → explicitly unrestricted (default).
	// - `[Restricted { groups }]` → only group members may trade.
	// - Multiple policies can coexist (e.g. `[Open, Restricted { groups }]`).
	trading_access : vec TradingAccess;
	// The canonical number of decimals used for prices and strikes in this series.
	price_precision : nat8;
	// The domain this market belongs to (e.g. Playground, Settlement).
	balance_domain : BalanceDomain;
	// The identifier of the oracle providing the settlement data.
	oracle_source : text;
	// If this series was forked from another, the source series ID.
	forked_from : opt text
};
// Input parameters for initiating a series settlement.
type SettleSeriesParams = record {
	// The derivative series identifier.
	series_id : text;
	// The final settlement data from the oracle.
	settlement : SettlementInput
};
// Outcome of a derivative series settlement request.
type SettleSeriesResult = variant {
	// Settlement plan was successfully created and all processing is complete.
	Ok;
	// Failed to initiate settlement.
	Err : SettlementError;
	// The settlement is in progress but incomplete due to processing limits.
	// The caller should call `settle_series` again to continue.
	Processing
};
// Errors occurring during derivative series settlement.
type SettlementError = variant {
	// A second `settle_series` call arrived with a `SettlementInput` that does
	// not match the one already locked in by the in-flight plan.
	//
	// Covers both `Price` and `Outcome` settlement types: the variant that's
	// locked is stored in `existing`, and the one just attempted is in
	// `requested`. Callers that need to surface a human-readable diff can
	// pattern-match on both variants without losing information.
	InconsistentSettlement : record {
		requested : SettlementInput;
		existing : SettlementInput
	};
	// Overflow during settlement calculation.
	MathOverflow;
	// Total net payoffs (post-fee) exceed global system equity (system insolvency).
	SolvencyViolation : record {
		total_net_payoff : nat;
		total_collateral_usd : nat
	};
	// An error occurred while interacting with the asset.
	Asset : AssetError;
	// A common error occurred.
	Common : CommonError
};
// Input data for settling a series.
type SettlementInput = variant {
	// Final price for scalar markets (Binary, Call, Put).
	Price : Price;
	// Resolved winner for categorical markets.
	Outcome : text
};
// A plan for processing a derivative series settlement in the background.
type SettlementPlan = record {
	// Current execution status of the plan.
	status : PlanStatus;
	// Base idempotency key in nanoseconds.
	idempotency_ns : PaymentIdempotency;
	// The unique identifier of the derivative series.
	series_id : text;
	// The protocol fee (in USD units).
	fee_usd : nat;
	// Tracks progress through accounting updates.
	accounting_cursor : nat64;
	// The insurance fee (in USD units).
	insurance_fee_usd : nat;
	// Detailed position snapshots and accounting updates.
	positions : vec SettlementPosition;
	// Whether all accounting updates have been applied to account states.
	accounting_applied : bool;
	// The domain of the series being settled.
	balance_domain : BalanceDomain;
	// The oracle source identifier for authorization.
	oracle_source : text;
	// The final settlement data.
	settlement : SettlementInput
};
// Snapshot of a single user's position and its settlement accounting.
type SettlementPosition = record {
	outcome_id : opt text;
	net_qty : int;
	user : principal;
	reserved_margin_usd : nat;
	cashflow_usd : int
};
// Public settlement progress for a derivative series.
type SettlementStatusView = record {
	status : PlanStatus;
	series_id : text;
	fee_usd : nat;
	accounting_cursor : nat64;
	insurance_fee_usd : nat;
	accounting_applied : bool;
	balance_domain : BalanceDomain;
	oracle_source : text;
	total_positions : nat64;
	settlement : SettlementInput
};
// Represents the side of an order or trade.
type Side = variant { Buy; Sell };
type SocialReward = record {
	// A short title for the reward (e.g., "Pizza 🍕").
	title : text;
	// An optional detailed description of the reward.
	description : opt text;
	// An optional icon URL for the reward.
	icon_url : opt text
};
// Represents structured statistics for the clearing system.
type Stats = record {
	// Total number of unique margin accounts.
	total_users : nat64;
	// Total collateral balance in margin accounts per asset.
	margin_balances : vec record { Asset; nat };
	// Total collateral locked across all positions.
	total_collateral_locked : nat;
	// Total number of executed trades.
	total_trades : nat64;
	// Total number of derivative series.
	total_series : nat64;
	// Total absolute open interest across all series.
	open_interest : nat;
	// Total number of events per type.
	event_counts : vec record { text; nat64 }
};
// Input parameters for submitting a limit order.
type SubmitLimitOrderParams = record {
	// The quantity of the order. Must be positive.
	qty : int;
	// The specific outcome for categorical markets.
	outcome_id : opt text;
	// The derivative series identifier.
	series_id : text;
	// The side of the order (Buy or Sell).
	side : Side;
	// Unique identifier for the order.
	order_id : text;
	// The limit price of the order.
	price : Price
};
// Input parameters for submitting a market order (taking an existing limit order).
type SubmitMarketOrderParams = record {
	// Unique identifier for the trade resulting from this match.
	trade_id : text;
	// The identifier of the limit order to be matched.
	matching_order_id : text
};
// Input parameters for submitting a matched trade from an exchange.
type SubmitMatchedTradeParams = record {
	// The quantity of the trade. Must be positive.
	qty : int;
	// Unique identifier for the trade provided by the exchange.
	trade_id : text;
	// The specific outcome for categorical markets.
	outcome_id : opt text;
	// The derivative series identifier.
	series_id : text;
	// The user opening or increasing a Short position (seller).
	seller : principal;
	// Optional amount to atomically unblock for the buyer.
	buyer_unblock_amount : opt nat;
	// The user opening or increasing a Long position (buyer).
	buyer : principal;
	// The execution price of the trade.
	price : Price;
	// Optional amount to atomically unblock for the seller.
	seller_unblock_amount : opt nat
};
// Outcome of a matched trade submission.
type SubmitMatchedTradeResult = variant {
	// Returns `true` if the trade was successfully processed.
	Ok : bool;
	// Failed to submit or match the trade.
	Err : TradeError
};
// Errors occurring during trade submission or matching.
type TradeError = variant {
	// A user tried to trade with themselves.
	SelfTradingNotAllowed;
	// The specified order was not found.
	OrderNotFound : text;
	// The trade would violate the no-arbitrage principle (e.g., sum of outcome prices > 1.0).
	ArbitrageLimitExceeded : record {
		// The hard limit (usually 1.0 USD).
		limit_usd : nat;
		// The current sum of best bids across all outcomes.
		sum_usd : nat
	};
	// Failed to communicate with the registry canister.
	RegistryError : text;
	// The user has insufficient margin to open or maintain the position.
	InsufficientMargin : record {
		// Current margin balance.
		balance : nat;
		// The user whose margin is insufficient.
		user : principal;
		// Required margin for the trade.
		required : nat
	};
	// The caller is not the creator of the order.
	NotOrderCreator;
	// The specified series was not found in the registry.
	SeriesNotFound : text;
	// The series has an active or finalised settlement plan, so no new
	// trades, orders, or transfers can be initiated on it.
	//
	// Returned whenever a trade-initiating path sees an entry in
	// `SETTLEMENT_PLANS` for the series. Once a series is settled it is
	// economically closed: positions are gone, winners' cash is booked,
	// and opening a new position could only create unbacked exposure.
	SeriesAlreadySettled : text;
	// The caller is not authorized to trade on this restricted series.
	//
	// Returned when a series carries `TradingAccess::Restricted` policies
	// and the caller is not a member of any of the referenced groups.
	// The caller should check `is_trading_authorized` on the registry
	// or contact the group creator to be added as a member.
	NotAuthorizedToTrade;
	// A common error occurred.
	Common : CommonError
};
// A single trading access policy attached to a derivative series.
//
// A [`Series`](super::series::Series) holds a `Vec<TradingAccess>`.
// Authorization is evaluated as a logical **OR** across all policies:
// if *any* policy in the list grants access to the caller, the caller
// may trade.
//
// # Invariant
//
// The `trading_access` vector on a [`Series`](super::series::Series) **must
// never be empty**. Every series must carry at least one policy. The default
// is `[Open]`. This invariant is enforced at the API level: `add_series`
// fills `[Open]` if empty, and `update_trading_access` rejects empty lists.
//
// # Combining policies
//
// A series may carry multiple policies simultaneously. For example:
// - `[Open]` — open to everyone (default).
// - `[Restricted { groups: [g1, g2] }]` — only members of g1 or g2.
// - `[Open, Restricted { groups: [g1] }]` — open to everyone *and* additionally tagged as
// belonging to g1 (useful for discovery/UI filtering).
//
// # Extensibility
//
// New variants (e.g. `TokenGated`, `ReputationBased`) can be added in
// the future without breaking existing policies or on-chain state.
type TradingAccess = variant {
	// Unrestricted: any authenticated (non-anonymous) caller can trade.
	Open;
	// Restricted to members of the specified groups.
	// The caller is authorized if they belong to **at least one** of the
	// listed groups.
	Restricted : record {
		// The group IDs whose members are allowed to trade.
		groups : vec text
	}
};
type UpdateAssetMetricsParams = record {
	metrics : AssetMetrics;
	asset_id : text
};
type UpdateAssetPriceError = variant {
	AssetNotFound;
	AssetMetricsNotInitialized;
	OracleNotConfigured;
	Common : CommonError
};
type UpdateAssetPriceParams = record { price : Price; asset_id : text };
type UpdateAssetPriceResult = variant { Ok; Err : UpdateAssetPriceError };
type UpdateCollateralAllowedDomainsError = variant {
	AssetNotFound;
	InvalidAllowedBalanceDomains
};
type UpdateCollateralAllowedDomainsParams = record {
	allowed_balance_domains : vec BalanceDomain;
	asset_id : text
};
type UpdateCollateralAllowedDomainsResult = variant {
	Ok;
	Err : UpdateCollateralAllowedDomainsError
};
type UpdateCollateralAssetParams = record { config : CollateralAssetConfig };
type UpdateDomainPolicyParams = record {
	domain : BalanceDomain;
	policy : DomainPolicy
};
// Errors occurring during collateral withdrawal.
type WithdrawCollateralError = variant {
	// The user does not have enough excess margin to withdraw the requested amount.
	InsufficientExcessMargin : record {
		// The amount requested to be withdrawn.
		requested : nat;
		// Current excess margin available for withdrawal.
		available : nat
	};
	// The asset is not permitted in this balance domain.
	DomainNotAllowed : record { domain : BalanceDomain; asset_id : text };
	// Overflow during collateral calculation.
	MathOverflow;
	// An error occurred while interacting with the asset.
	Asset : AssetError
};
// Input parameters for withdrawing collateral.
type WithdrawCollateralParams = record {
	// The specific balance domain to withdraw from (defaults to Settlement).
	domain : opt BalanceDomain;
	// Unique identifier for the withdrawal operation.
	withdrawal_id : text;
	// The unique identifier of the asset to withdraw.
	asset_id : text;
	// The amount of the asset to withdraw.
	amount : nat
};
// Outcome of a collateral withdrawal operation.
type WithdrawCollateralResult = variant {
	// Withdrawal was successfully planned or executed.
	Ok;
	// Failed to process withdrawal.
	Err : WithdrawCollateralError
};
type WithdrawFundError = variant {
	TransferFailed : text;
	InsufficientFunds;
	Common : CommonError
};
type WithdrawFundParams = record {
	to : principal;
	request_id : text;
	fund_type : FundType;
	asset_id : text;
	amount : nat
};
type WithdrawFundResult = variant { Ok : nat; Err : WithdrawFundError };
service : (Config) -> {
	// Accepts a position transfer from another clearing canister.
	//
	// This method validates the series and increases the target user's position based on the provided
	// proof. This method is gated to canister controllers.
	accept_position_transfer : (PositionProof) -> (AcceptPositionTransferResult);
	// Cancels a stuck fund withdrawal and refunds the internal ledger balance.
	//
	// This method is gated to canister controllers.
	cancel_fund_withdrawal : (CancelFundWithdrawalParams) -> (
		CancelFundWithdrawalResult
	);
	// Cancels an existing limit order and releases the reserved collateral.
	//
	// Only the creator of the order can cancel it.
	cancel_limit_order : (CancelLimitOrderParams) -> (SubmitMatchedTradeResult);
	// Returns the current global configuration of the Clearing canister.
	config : () -> (Config) query;
	// Deposits collateral into the user's account state.
	//
	// This is a multi-phase operation:
	// 1. Building a [`DepositPlan`] for idempotency.
	// 2. Executing the asynchronous ledger transfer (`transfer_from`).
	// 3. Finalising the internal collateral balances.
	deposit_collateral : (DepositCollateralParams) -> (DepositCollateralResult);
	// Freezes a user's position to prepare it for transfer to another clearing canister.
	//
	// Once frozen, the position is removed from active state and a [`PositionProof`] is issued.
	// This method is gated to canister controllers.
	freeze_position_for_transfer : (FreezePositionForTransferParams) -> (
		opt PositionProof
	);
	// Retrieves the current user's account state, optionally refreshing balances.
	//
	// # Arguments
	// * `params` - Includes an optional `refresh` flag to trigger external ledger checks.
	get_account_state : (GetAccountStateParams) -> (GetAccountStateResult);
	// Retrieves the current user's account state (query only).
	//
	// This does not refresh balances from external ledgers.
	get_account_state_query : () -> (GetAccountStateResult) query;
	// Returns the current domain policies for all configured domains.
	//
	// This method is gated to canister controllers.
	get_domain_policies : () -> (
		vec record { BalanceDomain; DomainPolicy }
	) query;
	// Returns the current balances of the Insurance Fund and Treasury.
	//
	// This method is gated to canister controllers.
	get_funds : () -> (GetFundsResult) query;
	// Retrieves all active limit orders for the caller.
	get_orders : () -> (vec LimitOrder) query;
	// Retrieves a specific position for the caller.
	get_position : (GetPositionParams) -> (opt Position) query;
	// Retrieves all open positions for the caller.
	get_positions : () -> (vec Position) query;
	// Returns the principal of the Series Registry canister.
	get_registry_canister : () -> (principal) query;
	// Returns the full settlement plan including per-position accounting details (admin only).
	get_settlement_plan : (text) -> (opt SettlementPlan) query;
	// Returns the public settlement progress for a derivative series without exposing user positions.
	get_settlement_status : (text) -> (opt SettlementStatusView) query;
	// Retrieves the trade history (executed trades) for the caller.
	get_trade_history : () -> (vec Event) query;
	// Returns the official number of decimals for USD accounting.
	get_usd_decimals : () -> (nat8) query;
	// Handles incoming HTTP requests for Prometheus metrics.
	//
	// This endpoint is restricted to canister controllers and serves metrics at `/metrics`.
	http_request : (HttpRequest) -> (HttpResponse) query;
	// Returns a list of all supported collateral assets with their metrics.
	list_collateral_assets : () -> (vec CollateralAssetInfo) query;
	// Returns a list of all active limit orders, potentially filtered by series.
	list_orders : (ListOrdersParams) -> (vec LimitOrder) query;
	// Returns a list of all derivative series currently cached in the clearing canister.
	list_series : () -> (vec Series) query;
	// Exports internal state as Prometheus metrics.
	//
	// This method is gated to canister controllers.
	metrics : () -> (text) query;
	// Migrates a user's entire domain state (balances, cash, margin, positions, orders)
	// from one balance domain to another.
	//
	// This operation is idempotent: providing the same `migration_id` returns `Ok`
	// if the migration was already finalised.
	//
	// Pre-conditions enforced:
	// - `from_domain != to_domain`
	// - No in-flight deposit, withdrawal, or settlement plans for the user in the source domain.
	// - User must have state to migrate.
	migrate_domain : (MigrateDomainParams) -> (MigrateDomainResult);
	// Mints a complete set of categorical outcome positions.
	//
	// Returns 1 unit of every outcome position in the series in exchange for the
	// full collateral requirement (1.0 USD vUSD).
	mint_complete_set : (text, int) -> (SubmitMatchedTradeResult);
	// Redeems a complete set of categorical outcome positions for collateral.
	//
	// Returns 1.0 USD (vUSD) for every full set of N outcome positions provided.
	redeem_complete_set : (text, int) -> (SubmitMatchedTradeResult);
	// Refreshes the metadata (decimals, fee, symbol) of an already registered ICRC asset.
	//
	// This method is gated to canister controllers.
	refresh_icrc_asset_metadata : (RefreshIcrcAssetMetadataParams) -> (
		RefreshIcrcAssetMetadataResult
	);
	// Automatically registers an ICRC asset by fetching its metadata from the ledger.
	//
	// This method is gated to canister controllers.
	register_icrc_asset : (RegisterIcrcAssetParams) -> (RegisterIcrcAssetResult);
	// Admin function to manually resume a stuck settlement plan, e.g., if the timer was dropped during
	// upgrade.
	resume_settlement : (text) -> (SettleSeriesResult);
	// Sets the principal of the Series Registry canister.
	//
	// This principal is used to discover and validate derivative series.
	// This method is gated to canister controllers.
	set_registry_canister : (principal) -> ();
	// Settles a derivative series at a specific price.
	//
	// This is a background operation consisting of:
	// 1. Creating or resuming a [`SettlementPlan`].
	// 2. Updating internal USD cash balances for all participants based on payoffs.
	// 3. Releasing margin requirements for the settled positions.
	// 4. Finalising the plan and removing the series data.
	//
	// **Note on Chunking:** To avoid instruction limits, this method processes positions in batches
	// of 100 per call. If there are many positions, the method will return
	// [`SettleSeriesResult::Processing`]. The caller must repeatedly call `settle_series` with the
	// same parameters until it returns [`SettleSeriesResult::Ok`].
	//
	// **Authorization:** Every call is gated to canister controllers or the designated oracle for
	// the series. Unauthorized callers are rejected even if a plan already exists.
	settle_series : (SettleSeriesParams) -> (SettleSeriesResult);
	// Exports internal state as a structured `Stats` object.
	//
	// This method is gated to canister controllers.
	stats : () -> (Stats) query;
	// Submits a limit order for the caller.
	//
	// This atomically blocks the required collateral for the order.
	submit_limit_order : (SubmitLimitOrderParams) -> (SubmitMatchedTradeResult);
	// Submits a market order to match an existing limit order.
	//
	// The caller is the taker.
	submit_market_order : (SubmitMarketOrderParams) -> (SubmitMatchedTradeResult);
	// Submits a matched trade from an exchange for clearing.
	//
	// NOTE: Access is currently restricted to authorized exchange intermediaries
	// (represented by canister controllers in this version).
	submit_matched_trade : (SubmitMatchedTradeParams) -> (
		SubmitMatchedTradeResult
	);
	// Adds or updates dynamic metrics for a collateral asset.
	//
	// This method is gated to canister controllers.
	update_asset_metrics : (UpdateAssetMetricsParams) -> ();
	// Updates the price of an asset.
	//
	// This method can be called by canister controllers or authorized oracles.
	update_asset_price : (UpdateAssetPriceParams) -> (UpdateAssetPriceResult);
	// Updates which balance domains may hold this collateral asset (deposits and withdrawals).
	//
	// This method is gated to canister controllers.
	update_collateral_allowed_domains : (
		UpdateCollateralAllowedDomainsParams
	) -> (UpdateCollateralAllowedDomainsResult);
	// Adds or updates a collateral asset configuration.
	//
	// This method is gated to canister controllers.
	update_collateral_asset : (UpdateCollateralAssetParams) -> ();
	// Updates the global configuration for the Clearing canister.
	//
	// Immutable properties like `internal_ledger_id` and `version` are preserved from the existing
	// state. This method is gated to canister controllers.
	update_config : (Config) -> ();
	// Adds or updates the policy for a specific balance domain.
	//
	// This method is gated to canister controllers.
	update_domain_policy : (UpdateDomainPolicyParams) -> ();
	// Withdraws collateral from the user's account state to an external address.
	//
	// This implements the "Deterministic Withdrawal Policy":
	// 1. Calculate current account equity in USD.
	// 2. Verify equity >= `reserved_margin_usd` (risk check).
	// 3. If ok, proceed with asynchronous ledger transfer.
	withdraw_collateral : (WithdrawCollateralParams) -> (
		WithdrawCollateralResult
	);
	// Withdraws assets from the Insurance Fund or Treasury to an external wallet.
	//
	// This method is gated to canister controllers.
	withdraw_fund : (WithdrawFundParams) -> (WithdrawFundResult)
}
